{
  "name": "Model",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "es-EC",
    "sourceQueryCulture": "es-EC",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Mes",
        "lineageTag": "d04975cd-21c2-5064-9d03-ca9a42ccd710",
        "columns": [
          {
            "name": "Id",
            "dataType": "int64",
            "sourceColumn": "Id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "sortByColumn": "Id"
          }
        ],
        "partitions": [
          {
            "name": "Mes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = if UsarPostgreSQL then",
                "        PostgreSQL.Database(ServidorPostgreSQL, \"compras_publicas\", [Query = \"SELECT mes AS \"\"Id\"\", (ARRAY['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'])[mes] AS \"\"Mes\"\" FROM generate_series(1, 12) AS serie(mes)\"])",
                "    else",
                "        Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i4421FFyzUtVitWJNtJRcktNArGMdZR8E4tALBMdJcckMMsUJFYJYpnpKHmV5oFY5iBWDohlAVSXng9iWeooBacWgFiGBjpK/sklYCbQFr/8MjATaI1LZrJSbCwA\", BinaryEncoding.Base64), Compression.Deflate)), {\"Id\", \"Mes\"}),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"Id\", Int64.Type}, {\"Mes\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Entidad",
        "lineageTag": "28480569-b1c8-506d-9cbe-4b8eac839d75",
        "columns": [
          {
            "name": "Id",
            "dataType": "int64",
            "sourceColumn": "Id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Entidad",
            "dataType": "string",
            "sourceColumn": "Entidad",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Entidad",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = if UsarPostgreSQL then",
                "        PostgreSQL.Database(ServidorPostgreSQL, \"compras_publicas\", [Query = \"WITH piloto AS ( SELECT p.*, dense_rank() OVER (ORDER BY entidad_id) AS entidad_clave FROM analitico.piloto_87141 p WHERE p.mes >= DATE '2025-01-01' AND p.mes < DATE '2026-01-01' ) SELECT DISTINCT entidad_clave AS \"\"Id\"\", entidad_nombre AS \"\"Entidad\"\" FROM piloto\"])",
                "    else",
                "        Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"Id\", \"Entidad\"}),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"Id\", Int64.Type}, {\"Entidad\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Procesos",
        "lineageTag": "3780eb48-149e-52b4-9562-47826036fa96",
        "columns": [
          {
            "name": "OCID",
            "dataType": "string",
            "sourceColumn": "OCID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "MesId",
            "dataType": "int64",
            "sourceColumn": "MesId",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "EntidadId",
            "dataType": "int64",
            "sourceColumn": "EntidadId",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Código",
            "dataType": "string",
            "sourceColumn": "Código",
            "summarizeBy": "none"
          },
          {
            "name": "Apertura",
            "dataType": "dateTime",
            "sourceColumn": "Apertura",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "Objeto",
            "dataType": "string",
            "sourceColumn": "Objeto",
            "summarizeBy": "none"
          },
          {
            "name": "Oferentes",
            "dataType": "int64",
            "sourceColumn": "Oferentes",
            "summarizeBy": "none"
          },
          {
            "name": "Adjudicado",
            "dataType": "boolean",
            "sourceColumn": "Adjudicado",
            "summarizeBy": "none"
          },
          {
            "name": "Días a la firma",
            "dataType": "int64",
            "sourceColumn": "Días a la firma",
            "summarizeBy": "none"
          },
          {
            "name": "Ficha SERCOP",
            "dataType": "string",
            "sourceColumn": "Ficha SERCOP",
            "summarizeBy": "none",
            "dataCategory": "WebUrl"
          }
        ],
        "partitions": [
          {
            "name": "Procesos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = if UsarPostgreSQL then",
                "        PostgreSQL.Database(ServidorPostgreSQL, \"compras_publicas\", [Query = \"WITH piloto AS ( SELECT p.*, dense_rank() OVER (ORDER BY entidad_id) AS entidad_clave FROM analitico.piloto_87141 p WHERE p.mes >= DATE '2025-01-01' AND p.mes < DATE '2026-01-01' ) SELECT p.ocid AS \"\"OCID\"\", extract(month FROM p.mes)::int AS \"\"MesId\"\", p.entidad_clave AS \"\"EntidadId\"\", p.codigo AS \"\"Código\"\", p.apertura AS \"\"Apertura\"\", p.objeto AS \"\"Objeto\"\", h.numero_oferentes AS \"\"Oferentes\"\", EXISTS (SELECT 1 FROM analitico.hecho_adjudicacion a WHERE a.ocid = p.ocid) AS \"\"Adjudicado\"\", (SELECT min(c.firma) - p.apertura FROM analitico.hecho_contrato c WHERE c.ocid = p.ocid AND c.firma >= p.apertura) AS \"\"Días a la firma\"\", 'https://datosabiertos.compraspublicas.gob.ec/PLATAFORMA/ocds/' || p.ocid AS \"\"Ficha SERCOP\"\" FROM piloto p JOIN analitico.hecho_proceso h USING (ocid)\"])",
                "    else",
                "        Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"OCID\", \"MesId\", \"EntidadId\", \"Código\", \"Apertura\", \"Objeto\", \"Oferentes\", \"Adjudicado\", \"Días a la firma\", \"Ficha SERCOP\"}),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"OCID\", type text}, {\"MesId\", Int64.Type}, {\"EntidadId\", Int64.Type}, {\"Código\", type text}, {\"Apertura\", type date}, {\"Objeto\", type text}, {\"Oferentes\", Int64.Type}, {\"Adjudicado\", type logical}, {\"Días a la firma\", Int64.Type}, {\"Ficha SERCOP\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Aperturas",
            "expression": "COUNTROWS(Procesos)",
            "formatString": "#,0"
          },
          {
            "name": "Entidades",
            "expression": "DISTINCTCOUNT(Procesos[EntidadId])",
            "formatString": "#,0"
          },
          {
            "name": "Meses activos",
            "expression": "DISTINCTCOUNT(Procesos[MesId])",
            "formatString": "#,0"
          },
          {
            "name": "Adjudicados con conteo",
            "expression": "CALCULATE([Aperturas], KEEPFILTERS(Procesos[Adjudicado] = TRUE()), KEEPFILTERS(NOT ISBLANK(Procesos[Oferentes])))",
            "formatString": "#,0"
          },
          {
            "name": "Adjudicados con 1 o 2",
            "expression": "CALCULATE([Adjudicados con conteo], KEEPFILTERS(Procesos[Oferentes] IN {1, 2}))",
            "formatString": "#,0"
          },
          {
            "name": "Proporción con 1 o 2 oferentes",
            "expression": "DIVIDE([Adjudicados con 1 o 2], [Adjudicados con conteo])",
            "formatString": "0.0%"
          },
          {
            "name": "Contratos en USD",
            "expression": "COUNTROWS(Contratos)",
            "formatString": "#,0"
          },
          {
            "name": "Contratos con proveedor",
            "expression": "CALCULATE([Contratos en USD], Contratos[Proveedor vinculado] = TRUE())",
            "formatString": "#,0"
          },
          {
            "name": "Mediana de contrato",
            "expression": "MEDIAN(Contratos[Monto USD])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "P25 de contrato",
            "expression": "PERCENTILE.INC(Contratos[Monto USD], 0.25)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "P75 de contrato",
            "expression": "PERCENTILE.INC(Contratos[Monto USD], 0.75)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Días hasta la firma",
            "expression": "MEDIAN(Procesos[Días a la firma])",
            "formatString": "0\" días\""
          },
          {
            "name": "Con firma",
            "expression": "COUNT(Procesos[Días a la firma])",
            "formatString": "#,0"
          },
          {
            "name": "Cobertura CPC",
            "expression": "1 - DIVIDE(SUM(Cobertura[Sin CPC]), SUM(Cobertura[Total]))",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "Contratos",
        "lineageTag": "6796607d-5456-552e-88fc-c16bd1a3bffb",
        "columns": [
          {
            "name": "OCID",
            "dataType": "string",
            "sourceColumn": "OCID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "MesId",
            "dataType": "int64",
            "sourceColumn": "MesId",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "EntidadId",
            "dataType": "int64",
            "sourceColumn": "EntidadId",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Monto USD",
            "dataType": "decimal",
            "sourceColumn": "Monto USD",
            "summarizeBy": "none"
          },
          {
            "name": "Proveedor vinculado",
            "dataType": "boolean",
            "sourceColumn": "Proveedor vinculado",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Contratos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = if UsarPostgreSQL then",
                "        PostgreSQL.Database(ServidorPostgreSQL, \"compras_publicas\", [Query = \"WITH piloto AS ( SELECT p.*, dense_rank() OVER (ORDER BY entidad_id) AS entidad_clave FROM analitico.piloto_87141 p WHERE p.mes >= DATE '2025-01-01' AND p.mes < DATE '2026-01-01' ) SELECT c.ocid AS \"\"OCID\"\", extract(month FROM p.mes)::int AS \"\"MesId\"\", p.entidad_clave AS \"\"EntidadId\"\", c.monto AS \"\"Monto USD\"\", EXISTS (SELECT 1 FROM analitico.contrato_proveedor cp WHERE cp.ocid = c.ocid AND cp.contrato_id = c.contrato_id) AS \"\"Proveedor vinculado\"\" FROM analitico.hecho_contrato c JOIN piloto p USING (ocid) WHERE c.moneda = 'USD' AND c.monto > 0\"])",
                "    else",
                "        Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), {\"OCID\", \"MesId\", \"EntidadId\", \"Monto USD\", \"Proveedor vinculado\"}),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"OCID\", type text}, {\"MesId\", Int64.Type}, {\"EntidadId\", Int64.Type}, {\"Monto USD\", Currency.Type}, {\"Proveedor vinculado\", type logical}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
