          }
        ],
        "partitions": [
          {
            "name": "Cobertura",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = if UsarPostgreSQL then",
                "        PostgreSQL.Database(ServidorPostgreSQL, \"compras_publicas\", [Query = \"SELECT extract(month FROM p.mes)::int AS \"\"MesId\"\", p.procesos AS \"\"Total\"\", p.sin_cpc AS \"\"Sin CPC\"\" FROM analitico.calidad_mensual p WHERE p.mes >= DATE '2025-01-01' AND p.mes < DATE '2026-01-01'\"])",
                "    else",
                "        Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"FY3JEQAgCAMbysMgl7U49t+G4cPsZoDcSxyC+XANtQ1ewq0kiW6xw7wUeEgC7NBYlCR4PHHmuGC7FdhIo7rgJjwgw5HDXPqSqpljqjWyUGvEYEbtxnrvAw==\", BinaryEncoding.Base64), Compression.Deflate)), {\"MesId\", \"Total\", \"Sin CPC\"}),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"MesId\", Int64.Type}, {\"Total\", Int64.Type}, {\"Sin CPC\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      }
    ],
